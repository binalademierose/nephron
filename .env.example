# Copy this file to ".env" and fill in your own values. Never share or commit ".env".
#
# ============================  FOR PRODUCTION  ============================
# When you deploy (Vercel, Render, a server), set these as environment variables, NOT in a committed file:
#   SECRET_KEY=<a fresh 64-char value - never reuse a dev one>
#   FLASK_DEBUG=0              <- MUST be 0 in production (1 exposes a code-execution debugger and preview pages)
#   SESSION_COOKIE_SECURE=1    <- the session cookie is sent only over HTTPS
#   TRUSTED_PROXY_COUNT=1      <- when one proxy (Vercel/nginx) terminates HTTPS in front of the app
# ==========================================================================

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 while developing (shows the debugger, /style-guide and the /design/ previews), 0 in production.
FLASK_DEBUG=1

# MySQL connection. In production point these at your managed MySQL (PlanetScale, Aiven, Railway, ...).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nephron

# Sessions
SESSION_LIFETIME_MINUTES=30
# Set to 1 only when the site is served over HTTPS (production). 0 for local http development.
SESSION_COOKIE_SECURE=0

# How many trusted reverse proxies sit in front of the app. 0 = reached directly (local dev). Behind exactly one
# proxy that terminates HTTPS (Vercel, nginx), set to 1 so HTTPS, secure cookies and the logged client IP are read
# from the proxy's forwarded headers. Leave at 0 unless you actually run behind a proxy (it is an anti-spoofing guard).
TRUSTED_PROXY_COUNT=0

# Dashboard rules (both are optional)
# Days that must pass between two screenings. Leave empty for no waiting period.
REASSESSMENT_DAYS=
# The time zone dates are shown in (times are stored in UTC). Any name from the tz database, for example Asia/Manila.
APP_TIMEZONE=Asia/Manila

# Where the saved model is (the folder with model_metadata.json). Leave empty to use ml/model. See ml/README.md.
MODEL_DIR=

# Only needed if `tesseract` is not already on PATH (common on Windows). The full path to tesseract.exe, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
